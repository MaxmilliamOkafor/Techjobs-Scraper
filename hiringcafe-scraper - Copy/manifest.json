{
  "manifest_version": 3,
  "name": "Tech Jobs URL Scraper",
  "version": "2.3.0",
  "description": "Scrapes job listings and resolves real external apply URLs from hiring.cafe, eurotoptech.com, and simplify.jobs.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://hiring.cafe/*",
    "https://*.hiring.cafe/*",
    "https://eurotoptech.com/*",
    "https://*.eurotoptech.com/*",
    "https://simplify.jobs/*",
    "https://*.simplify.jobs/*",
    "https://app.lazyapply.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tech Jobs Scraper"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hiring.cafe/*",
        "https://*.hiring.cafe/*",
        "https://eurotoptech.com/*",
        "https://*.eurotoptech.com/*",
        "https://simplify.jobs/*",
        "https://*.simplify.jobs/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://simplify.jobs/*",
        "https://*.simplify.jobs/*"
      ],
      "js": [
        "sj-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
